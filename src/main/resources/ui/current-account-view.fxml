<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ferreteria.controllers.CurrentAccountController"
            fx:id="rootPane"
            styleClass="current-account-view-root">

    <top>
        <VBox spacing="12">
            <children>
                <Label text="Cuentas corrientes" styleClass="view-title"/>

                <!-- Toolbar: 2 filas para que siempre quepa en cualquier ancho -->
                <VBox spacing="8" styleClass="customers-toolbar current-account-toolbar">
                    <!-- Fila 1: búsqueda -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="searchCustomerField"
                                   promptText="Buscar cliente por nombre o apellido..."
                                   HBox.hgrow="ALWAYS"/>
                        <Button text="Buscar" onAction="#onSearchCustomer"
                                styleClass="customers-search-button" minWidth="90" prefWidth="100"/>
                        <Button text="Restablecer" onAction="#onResetCustomerFilter"
                                styleClass="customers-secondary-button" minWidth="110" prefWidth="130"/>
                    </HBox>
                    <!-- Fila 2: selección de cliente + exportar -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <ComboBox fx:id="customerCombo" promptText="Seleccionar cliente"
                                  HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="exportPdfButton" text="Exportar PDF" onAction="#onExportPdf"
                                styleClass="current-account-export-button" minWidth="130" prefWidth="150"/>
                    </HBox>
                </VBox>

                <!-- Tarjeta de datos del cliente -->
                <GridPane hgap="16" vgap="10" styleClass="customers-summary-card-neutral">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="20"/>
                        <ColumnConstraints percentWidth="20"/>
                        <ColumnConstraints percentWidth="20"/>
                        <ColumnConstraints percentWidth="20"/>
                        <ColumnConstraints percentWidth="20"/>
                    </columnConstraints>
                    <VBox GridPane.columnIndex="0" spacing="4">
                        <Label text="Nombre" styleClass="customers-summary-title"/>
                        <Label fx:id="customerNameLabel" text="-" styleClass="customers-summary-value" wrapText="true"/>
                    </VBox>
                    <VBox GridPane.columnIndex="1" spacing="4">
                        <Label text="Teléfono" styleClass="customers-summary-title"/>
                        <Label fx:id="customerPhoneLabel" text="-" styleClass="customers-summary-value" wrapText="true"/>
                    </VBox>
                    <VBox GridPane.columnIndex="2" spacing="4">
                        <Label text="Dirección" styleClass="customers-summary-title"/>
                        <Label fx:id="customerAddressLabel" text="-" styleClass="customers-summary-value" wrapText="true"/>
                    </VBox>
                    <VBox GridPane.columnIndex="3" spacing="4">
                        <Label text="Límite" styleClass="customers-summary-title"/>
                        <Label fx:id="customerLimitLabel" text="Sin limite" styleClass="customers-summary-value" wrapText="true"/>
                    </VBox>
                    <VBox GridPane.columnIndex="4" spacing="4">
                        <Label text="Disponible" styleClass="customers-summary-title"/>
                        <Label fx:id="customerAvailableLabel" text="-" styleClass="customers-summary-value" wrapText="true"/>
                    </VBox>
                </GridPane>

                <!-- Tarjetas de resumen -->
                <GridPane hgap="14" vgap="14" styleClass="customers-summary-grid">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>
                    <VBox styleClass="customers-summary-card-primary" GridPane.columnIndex="0" spacing="4">
                        <Label text="Deuda actual" styleClass="customers-summary-title"/>
                        <Label fx:id="summaryBalanceLabel" text="\$ 0,00" styleClass="customers-summary-value"/>
                    </VBox>
                    <VBox styleClass="customers-summary-card-neutral" GridPane.columnIndex="1" spacing="4">
                        <Label text="Ventas con deuda" styleClass="customers-summary-title"/>
                        <Label fx:id="summaryPendingSalesLabel" text="0" styleClass="customers-summary-value"/>
                    </VBox>
                </GridPane>
            </children>
            <padding>
                <Insets top="0" right="0" bottom="12" left="0"/>
            </padding>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" pannable="true" styleClass="summary-scroll">
            <content>
                <VBox spacing="10">
                    <HBox alignment="BOTTOM_LEFT" spacing="10">
                        <Label text="Deuda por venta" styleClass="summary-panel-title"/>
                        <Label text="(doble clic en una venta para ver qué productos incluye)"
                               styleClass="summary-panel-hint"/>
                    </HBox>
                    <TableView fx:id="debtTable" prefHeight="200" styleClass="customers-table">
                        <columns>
                            <TableColumn fx:id="colDebtSaleId" text="Venta" minWidth="60" prefWidth="70"/>
                            <TableColumn fx:id="colDebtDate" text="Fecha" minWidth="120" prefWidth="160"/>
                            <TableColumn fx:id="colDebtTotal" text="Total venta" minWidth="100" prefWidth="130" styleClass="numeric-column"/>
                            <TableColumn fx:id="colDebtApplied" text="Pagado" minWidth="90" prefWidth="120" styleClass="numeric-column"/>
                            <TableColumn fx:id="colDebtPending" text="Pendiente" minWidth="90" prefWidth="120" styleClass="numeric-column"/>
                            <TableColumn fx:id="colDebtStatus" text="Estado" minWidth="80" prefWidth="110"/>
                        </columns>
                    </TableView>

                    <Separator/>

                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="Movimientos" styleClass="summary-panel-title"/>
                        <Button fx:id="deleteMovementButton" text="Eliminar ajuste"
                                onAction="#onDeleteMovement"
                                styleClass="report-delete-button"
                                disable="true" minWidth="130"/>
                    </HBox>
                    <TableView fx:id="movementTable" prefHeight="200" styleClass="customers-table">
                        <columns>
                            <TableColumn fx:id="colMovDate" text="Fecha" minWidth="120" prefWidth="160"/>
                            <TableColumn fx:id="colMovType" text="Tipo" minWidth="70" prefWidth="90"/>
                            <TableColumn fx:id="colMovAmount" text="Monto" minWidth="90" prefWidth="110" styleClass="numeric-column"/>
                            <TableColumn fx:id="colMovBalance" text="Saldo" minWidth="90" prefWidth="110" styleClass="numeric-column"/>
                            <TableColumn fx:id="colMovRef" text="Referencia" minWidth="80" prefWidth="110"/>
                            <TableColumn fx:id="colMovNotes" text="Detalle" minWidth="120" prefWidth="240"/>
                        </columns>
                    </TableView>

                    <Separator/>

                    <!-- Registrar pago -->
                    <VBox spacing="8">
                        <Label text="Registrar pago" styleClass="summary-panel-title"/>
                        <HBox fx:id="paymentRow" spacing="8" alignment="CENTER_LEFT">
                            <TextField fx:id="paymentAmountField" promptText="Monto (ej. 15000,50)"
                                       prefWidth="170" minWidth="120"/>
                            <ComboBox fx:id="paymentMethodCombo" prefWidth="150" minWidth="120"/>
                            <TextField fx:id="paymentNotesField" promptText="Observacion (opcional)"
                                       HBox.hgrow="ALWAYS" minWidth="100"/>
                            <Button fx:id="registerPaymentButton" text="Registrar pago"
                                    onAction="#onRegisterPayment" styleClass="customers-search-button"
                                    minWidth="130"/>
                        </HBox>
                    </VBox>

                    <!-- Registrar deuda anterior -->
                    <VBox spacing="8">
                        <Label text="Registrar deuda anterior" styleClass="summary-panel-title"/>
                        <HBox fx:id="initialDebtRow" spacing="8" alignment="CENTER_LEFT">
                            <TextField fx:id="initialDebtAmountField" promptText="Monto deuda anterior"
                                       prefWidth="200" minWidth="140"/>
                            <TextField fx:id="initialDebtNotesField" promptText="Detalle (opcional)"
                                       HBox.hgrow="ALWAYS" minWidth="100"/>
                            <Button fx:id="registerInitialDebtButton" text="Registrar deuda"
                                    onAction="#onRegisterInitialDebt" styleClass="current-account-export-button"
                                    minWidth="130"/>
                        </HBox>
                        <padding>
                            <Insets bottom="10"/>
                        </padding>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

</BorderPane>
