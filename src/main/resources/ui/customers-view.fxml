<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ferreteria.controllers.CustomersController"
            styleClass="customers-view-root">

    <top>
        <VBox spacing="12">
            <children>
                <Label text="Clientes" styleClass="view-title"/>
                <FlowPane hgap="8" vgap="8" prefWrapLength="900" styleClass="customers-toolbar">
                    <children>
                        <TextField fx:id="searchField" promptText="Buscar por nombre, teléfono o dirección..." prefWidth="300"/>
                        <Button text="Buscar" onAction="#onSearch" styleClass="customers-search-button"/>
                        <Button text="Restablecer" onAction="#onResetFilter" styleClass="customers-secondary-button"/>
                        <Button text="Nuevo" onAction="#onNewCustomer" styleClass="customers-secondary-button"/>
                        <Button text="Editar" onAction="#onEditCustomer" styleClass="customers-secondary-button"/>
                        <Button text="Eliminar" onAction="#onDeleteCustomer" styleClass="customers-danger-button"/>
                    </children>
                </FlowPane>
                <GridPane hgap="14" vgap="14" styleClass="customers-summary-grid">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>
                    <VBox styleClass="customers-summary-card-primary" GridPane.columnIndex="0" spacing="4">
                        <Label text="Clientes mostrados" styleClass="customers-summary-title"/>
                        <Label fx:id="summaryTotalCustomersLabel" text="0" styleClass="customers-summary-value"/>
                        <Label text="Cantidad visible según el filtro actual" styleClass="customers-summary-note" wrapText="true"/>
                    </VBox>
                    <VBox styleClass="customers-summary-card-neutral" GridPane.columnIndex="1" spacing="4">
                        <Label text="Búsqueda actual" styleClass="customers-summary-title"/>
                        <Label fx:id="summaryCurrentFilterLabel" text="Todos" styleClass="customers-summary-value"/>
                        <Label text="Muestra si estás viendo todos los clientes o un filtro puntual" styleClass="customers-summary-note" wrapText="true"/>
                    </VBox>
                </GridPane>
            </children>
            <padding>
                <Insets top="0" right="0" bottom="12" left="0"/>
            </padding>
        </VBox>
    </top>

    <center>
        <TableView fx:id="customersTable" prefHeight="400.0" styleClass="customers-table">
            <columns>
                <TableColumn fx:id="colName" text="Nombre" prefWidth="220.0"/>
                <TableColumn fx:id="colPhone" text="Teléfono" prefWidth="140.0"/>
                <TableColumn fx:id="colAddress" text="Dirección" prefWidth="250.0"/>
                <TableColumn fx:id="colCreditLimit" text="Límite crédito" prefWidth="130.0"/>
            </columns>
        </TableView>
    </center>

    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

</BorderPane>
