<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="reportsRoot"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ferreteria.controllers.ReportsController"
            styleClass="reports-view-root">

    <top>
        <VBox spacing="10">
            <!-- Toolbar card -->
            <VBox spacing="10" styleClass="reports-toolbar">
                <Label fx:id="viewTitleLabel" text="Reportes" styleClass="view-title"/>
                <HBox fx:id="filterRow" spacing="10" alignment="CENTER_LEFT">
                    <Label text="Desde:" styleClass="reports-filter-label"/>
                    <DatePicker fx:id="dateFrom" prefWidth="140"/>
                    <ComboBox fx:id="comboTimeFrom" prefWidth="90"/>
                    <Label text="Hasta:" styleClass="reports-filter-label"/>
                    <DatePicker fx:id="dateTo" prefWidth="140"/>
                    <ComboBox fx:id="comboTimeTo" prefWidth="90"/>
                    <ComboBox fx:id="reportTypeCombo" prefWidth="165" promptText="Tipo de reporte"/>
                </HBox>
                <HBox fx:id="buttonRow" spacing="8" alignment="CENTER_LEFT">
                    <Button text="Hoy" onAction="#onToday" styleClass="report-period-button"/>
                    <Button text="Esta semana" onAction="#onThisWeek" styleClass="report-period-button"/>
                    <Button text="Este mes" onAction="#onThisMonth" styleClass="report-period-button"/>
                    <Button text="Este año" onAction="#onThisYear" styleClass="report-period-button"/>
                    <Button text="Generar" onAction="#onGenerate" styleClass="report-generate-button"/>
                    <Button fx:id="btnDeleteSale" text="Eliminar venta" onAction="#onDeleteSale"
                            styleClass="report-delete-button" disable="true"/>
                </HBox>
            </VBox>
            <!-- Summary cards below the toolbar -->
            <HBox fx:id="summaryCards" spacing="10" visible="false" managed="false">
                <VBox fx:id="sCard1" styleClass="report-summary-card report-summary-card-blue" HBox.hgrow="ALWAYS">
                    <Label fx:id="sCard1Title" styleClass="report-summary-card-title"/>
                    <Label fx:id="sCard1Value" styleClass="report-summary-card-value"/>
                </VBox>
                <VBox fx:id="sCard2" styleClass="report-summary-card report-summary-card-green" HBox.hgrow="ALWAYS">
                    <Label fx:id="sCard2Title" styleClass="report-summary-card-title"/>
                    <Label fx:id="sCard2Value" styleClass="report-summary-card-value"/>
                </VBox>
                <VBox fx:id="sCard3" styleClass="report-summary-card report-summary-card-cyan" HBox.hgrow="ALWAYS">
                    <Label fx:id="sCard3Title" styleClass="report-summary-card-title"/>
                    <Label fx:id="sCard3Value" styleClass="report-summary-card-value"/>
                </VBox>
                <VBox fx:id="sCard4" styleClass="report-summary-card report-summary-card-cyan" HBox.hgrow="ALWAYS">
                    <Label fx:id="sCard4Title" styleClass="report-summary-card-title"/>
                    <Label fx:id="sCard4Value" styleClass="report-summary-card-value"/>
                </VBox>
                <VBox fx:id="sCard5" styleClass="report-summary-card report-summary-card-neutral" HBox.hgrow="ALWAYS">
                    <Label fx:id="sCard5Title" styleClass="report-summary-card-title"/>
                    <Label fx:id="sCard5Value" styleClass="report-summary-card-value-sm"/>
                </VBox>
                <VBox fx:id="sCard6" styleClass="report-summary-card report-summary-card-neutral" HBox.hgrow="ALWAYS">
                    <Label fx:id="sCard6Title" styleClass="report-summary-card-title"/>
                    <Label fx:id="sCard6Value" styleClass="report-summary-card-value-sm"/>
                </VBox>
            </HBox>
            <padding>
                <Insets bottom="8"/>
            </padding>
        </VBox>
    </top>

    <center>
        <StackPane>
            <!-- Rentabilidad panel -->
            <VBox fx:id="profitPanel" visible="false" managed="false" spacing="12"
                  styleClass="profit-panel" StackPane.alignment="TOP_LEFT">
                <HBox spacing="12">
                    <VBox styleClass="report-card report-card-blue" HBox.hgrow="ALWAYS">
                        <Label text="Total en ventas" styleClass="report-card-title"/>
                        <Label fx:id="profitDevengadoLabel" text="\$ 0,00" styleClass="report-card-value"/>
                    </VBox>
                    <VBox styleClass="report-card report-card-green" HBox.hgrow="ALWAYS">
                        <Label text="Ingresos cobrados" styleClass="report-card-title"/>
                        <Label fx:id="profitCobradoLabel" text="\$ 0,00" styleClass="report-card-value"/>
                    </VBox>
                    <VBox styleClass="report-card report-card-red" HBox.hgrow="ALWAYS">
                        <Label text="Gastos" styleClass="report-card-title"/>
                        <Label fx:id="profitGastosLabel" text="\$ 0,00" styleClass="report-card-value"/>
                    </VBox>
                    <VBox styleClass="report-card report-card-neutral" HBox.hgrow="ALWAYS">
                        <Label text="Neto" styleClass="report-card-title"/>
                        <Label fx:id="profitNetoCajaLabel" text="\$ 0,00" styleClass="report-card-value"/>
                    </VBox>
                </HBox>
                <HBox fx:id="profitCcRow" spacing="12">
                    <VBox styleClass="report-card report-card-cyan" HBox.hgrow="ALWAYS">
                        <Label text="Ventas en cuenta corriente" styleClass="report-card-title"/>
                        <Label fx:id="profitCcSalesLabel" text="\$ 0,00" styleClass="report-card-value"/>
                        <Label text="Ventas fiadas registradas en el periodo" styleClass="report-card-note"/>
                    </VBox>
                    <VBox styleClass="report-card report-card-cyan" HBox.hgrow="ALWAYS">
                        <Label text="Pagos de cuenta corriente" styleClass="report-card-title"/>
                        <Label fx:id="profitCcPaymentsLabel" text="\$ 0,00" styleClass="report-card-value"/>
                        <Label text="Cobros reales de cuentas corrientes" styleClass="report-card-note"/>
                    </VBox>
                </HBox>
                <!-- Resumen explicativo -->
                <VBox spacing="6" styleClass="profit-narrative-box">
                    <Label fx:id="profitLine1" wrapText="true" styleClass="profit-narrative-line"/>
                    <Label fx:id="profitLine2" wrapText="true" styleClass="profit-narrative-line"/>
                    <Label fx:id="profitLine3" wrapText="true" styleClass="profit-narrative-line"/>
                    <Label fx:id="profitLine4" wrapText="true" styleClass="profit-narrative-result"/>
                </VBox>

                <!-- Gráfico de evolución -->
                <LineChart fx:id="profitLineChart" animated="false" legendVisible="false"
                           title="Evolución de ventas del período"
                           styleClass="profit-chart profit-line-chart"
                           prefHeight="200" VBox.vgrow="NEVER" createSymbols="false">
                    <xAxis><CategoryAxis tickLabelRotation="45"/></xAxis>
                    <yAxis><NumberAxis/></yAxis>
                </LineChart>
            </VBox>

            <TableView fx:id="tableByDay" maxWidth="Infinity" maxHeight="Infinity">
                <columns>
                    <TableColumn fx:id="colDay" text="Día" prefWidth="130" minWidth="115"/>
                    <TableColumn fx:id="colDayTotal" text="Total ($)" prefWidth="100" minWidth="88" styleClass="numeric-column"/>
                    <TableColumn fx:id="colDayCash" text="Efectivo ($)" prefWidth="92" minWidth="82" styleClass="numeric-column"/>
                    <TableColumn fx:id="colDayTransfer" text="Transferencia ($)" prefWidth="118" minWidth="105" styleClass="numeric-column"/>
                    <TableColumn fx:id="colDayDebit" text="Débito ($)" prefWidth="88" minWidth="78" styleClass="numeric-column"/>
                    <TableColumn fx:id="colDayCredit" text="Crédito ($)" prefWidth="88" minWidth="78" styleClass="numeric-column"/>
                    <TableColumn fx:id="colDayCurrentAccount" text="Cta. corriente ($)" prefWidth="120" minWidth="108" styleClass="numeric-column"/>
                </columns>
            </TableView>

            <TableView fx:id="tableProducts" visible="false" maxWidth="Infinity" maxHeight="Infinity">
                <columns>
                    <TableColumn fx:id="colCode" text="Código" prefWidth="80" minWidth="70"/>
                    <TableColumn fx:id="colProductName" text="Producto" prefWidth="180" minWidth="150"/>
                    <TableColumn fx:id="colQty" text="Cant. vendida" prefWidth="100" minWidth="88" styleClass="numeric-column"/>
                    <TableColumn fx:id="colRevenue" text="Monto total ($)" prefWidth="120" minWidth="105" styleClass="numeric-column"/>
                </columns>
            </TableView>

            <TableView fx:id="tableDetail" visible="false" maxWidth="Infinity" maxHeight="Infinity">
                <columns>
                    <TableColumn fx:id="colDetailDate" text="Fecha y hora" prefWidth="115" minWidth="100"/>
                    <TableColumn fx:id="colDetailSaleId" text="Nro Venta" prefWidth="80" minWidth="70" styleClass="numeric-column"/>
                    <TableColumn fx:id="colDetailSummary" text="Resumen" prefWidth="260" minWidth="180"/>
                    <TableColumn fx:id="colDetailSaleTotal" text="Total venta ($)" prefWidth="120" minWidth="100" styleClass="numeric-column"/>
                    <TableColumn fx:id="colDetailPayment" text="Medio pago" prefWidth="100" minWidth="90"/>
                    <TableColumn fx:id="colDetailActions" text="Acciones" prefWidth="170" minWidth="155"/>
                </columns>
            </TableView>

            <TableView fx:id="tableCurrentAccount" visible="false" managed="false" maxWidth="Infinity" maxHeight="Infinity">
                <columns>
                    <TableColumn fx:id="colCcCustomer" text="Cliente" prefWidth="200" minWidth="160"/>
                    <TableColumn fx:id="colCcSales" text="Ventas CC ($)" prefWidth="115" minWidth="100" styleClass="numeric-column"/>
                    <TableColumn fx:id="colCcPayments" text="Pagos CC ($)" prefWidth="105" minWidth="92" styleClass="numeric-column"/>
                    <TableColumn fx:id="colCcFinalDebt" text="Saldo final ($)" prefWidth="110" minWidth="96" styleClass="numeric-column"/>
                    <TableColumn fx:id="colCcExport" text="Comprobante" prefWidth="190" minWidth="180"/>
                </columns>
            </TableView>
        </StackPane>
    </center>

    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

</BorderPane>
