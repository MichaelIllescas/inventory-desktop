<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ferreteria.controllers.SettingsController"
      spacing="20" styleClass="settings-root">

    <Label text="Configuración" styleClass="view-title"/>
    <Label text="Estos datos aparecerán en los comprobantes PDF generados por el sistema."
           styleClass="settings-subtitle" wrapText="true"/>

    <Separator/>

    <!-- Datos del negocio -->
    <Label text="Datos del negocio" styleClass="settings-section-title"/>

    <GridPane hgap="16" vgap="12">
        <columnConstraints>
            <ColumnConstraints percentWidth="20"/>
            <ColumnConstraints percentWidth="80"/>
        </columnConstraints>

        <Label text="Nombre" styleClass="settings-field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="fieldName" promptText="Ej: Ferretería Don Juan"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Dirección" styleClass="settings-field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="fieldAddress" promptText="Ej: Av. Siempreviva 742, Buenos Aires"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Teléfono" styleClass="settings-field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="fieldPhone" promptText="Ej: (011) 4123-4567"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="CUIT" styleClass="settings-field-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="fieldCuit" promptText="Ej: 20-12345678-9"
                   GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>

    <Separator/>

    <!-- Logo -->
    <Label text="Logo del negocio" styleClass="settings-section-title"/>
    <Label text="Se mostrará en el encabezado del comprobante PDF. Formatos: PNG, JPG. Tamaño recomendado: 300×100 px."
           styleClass="settings-subtitle" wrapText="true"/>

    <HBox spacing="16" alignment="CENTER_LEFT">
        <VBox styleClass="settings-logo-preview-box" alignment="CENTER" minWidth="220" minHeight="90">
            <ImageView fx:id="logoPreview" fitWidth="200" fitHeight="80" preserveRatio="true" pickOnBounds="true"/>
        </VBox>
        <VBox spacing="8" alignment="CENTER_LEFT">
            <Label fx:id="logoPathLabel" text="Sin logo seleccionado" styleClass="settings-logo-path"/>
            <HBox spacing="8">
                <Button text="Elegir logo..." onAction="#onChooseLogo" styleClass="settings-primary-button"/>
                <Button fx:id="btnRemoveLogo" text="Quitar" onAction="#onRemoveLogo"
                        styleClass="settings-danger-button" disable="true"/>
            </HBox>
        </VBox>
    </HBox>

    <Separator/>

    <!-- Impresión de tickets -->
    <Label text="Impresión de tickets" styleClass="settings-section-title"/>
    <Label text="Elegí la impresora de comandas y el ancho del rollo. El ticket sale directo, sin diálogo. Para probar sin impresora térmica, elegí &quot;Microsoft Print to PDF&quot;."
           styleClass="settings-subtitle" wrapText="true"/>

    <GridPane hgap="16" vgap="12">
        <columnConstraints>
            <ColumnConstraints percentWidth="20"/>
            <ColumnConstraints percentWidth="80"/>
        </columnConstraints>

        <Label text="Impresora" styleClass="settings-field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <HBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="1">
            <ComboBox fx:id="printerCombo" prefWidth="340"/>
            <Button text="Actualizar lista" onAction="#onRefreshPrinters" styleClass="settings-primary-button"/>
            <Button text="Ticket de prueba" onAction="#onTestTicket" styleClass="settings-primary-button"/>
        </HBox>

        <Label text="Ancho del rollo" styleClass="settings-field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="paperWidthCombo" prefWidth="200"
                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>

    <Separator/>

    <HBox>
        <Button text="Guardar configuración" onAction="#onSave" styleClass="settings-save-button"/>
    </HBox>

    <padding>
        <Insets top="16" right="24" bottom="24" left="24"/>
    </padding>
</VBox>
